# AI Knowledge Retrieval and Multi-Agent RAG System Configuration

# Optional External LLM Provider (openai, gemini, anthropic)
# Leave empty to use built-in safe extractive synthesis fallback (Zero-Hallucination)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Vector Database Storage Path
CHROMA_PATH=./data/chroma
COLLECTION_NAME=knowledge_chunks

# Document Chunking Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# Retrieval Relevance Filter Threshold (0.0 to 1.0)
RETRIEVAL_THRESHOLD=0.35

# Embedding Model (SentenceTransformer)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths
UPLOAD_DIR=./data/uploads
SQLITE_DB_PATH=./data/metadata.db
